# Fleet-wide secrets - PLAINTEXT template.
# 1. Copy it:     cp secrets/common.yaml.template secrets/common.yaml
# 2. Fill in the values below.
# 3. Encrypt it:  sops -e -i secrets/common.yaml
#    (requires .sops.yaml configured first - see common/config/SECRETS.md; note that sops
#    drops these comments when encrypting).
# From then on, edit it only with: sops secrets/common.yaml

# WiFi pre-shared keys, one variable per network, consumed by
# hosts/*/nm_configurations.nix through NetworkManager's ensureProfiles:
wifi_env: |
    WIFI_HOME_PSK=CHANGEME
    WIFI_OFFICE_PSK=CHANGEME

# The user's password hash, consumed by users/XYZ/user.nix.
# Generate it with: mkpasswd -m sha-512
user_hashedPassword: CHANGEME
