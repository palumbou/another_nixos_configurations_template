# Minimal hardware defaults; replace with the target's detected configuration.
{ config, lib, modulesPath, ... }:
{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];
  nixpkgs.hostPlatform = lib.mkDefault "${PLATFORM}";
  hardware.enableRedistributableFirmware = true;
  networking.useDHCP = lib.mkDefault false;

  boot.initrd.availableKernelModules = [
    "xhci_pci" "nvme" "ahci" "sd_mod" "usb_storage"
    "virtio_pci" "virtio_blk" "virtio_scsi"
  ];
  hardware.cpu.intel.updateMicrocode = lib.mkIf ("${CPU_VENDOR}" == "intel")
    (lib.mkDefault config.hardware.enableRedistributableFirmware);
  hardware.cpu.amd.updateMicrocode = lib.mkIf ("${CPU_VENDOR}" == "amd")
    (lib.mkDefault config.hardware.enableRedistributableFirmware);
}
