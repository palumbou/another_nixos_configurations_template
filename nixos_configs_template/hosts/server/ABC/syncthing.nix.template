{ config, lib, ... }:
let
  remoteDeviceId = "${SYNCTHING_DEVICE_ID}";
  remoteReady = remoteDeviceId != "";
in
{
  services.syncthing = {
    enable = ${ENABLE_SYNCTHING};
    systemService = true;
    user = "syncthing";
    group = "syncthing";

    # Keep service state and its database outside the shared work tree.
    dataDir = "/var/lib/syncthing";
    configDir = "/var/lib/syncthing/.config/syncthing";
    databaseDir = config.services.syncthing.configDir;

    # Reach the HTTPS interface through an SSH tunnel.
    guiAddress = "https://127.0.0.1:8843";
    openDefaultPorts = false;
    overrideDevices = true;
    overrideFolders = true;

    settings = {
      gui = {
        enabled = true;
        tls = true;
        theme = "black";
      };
      options = {
        listenAddresses = [ "tcp4://:22222" ];
        globalAnnounceEnabled = false;
        localAnnounceEnabled = false;
        natEnabled = false;
        relaysEnabled = false;
        startBrowser = false;
        urAccepted = -1;
      };
      devices = lib.optionalAttrs remoteReady {
        storage = {
          id = remoteDeviceId;
          name = "Storage peer";
          addresses = [ "${SYNCTHING_ADDRESS}" ];
          compression = "metadata";
          autoAcceptFolders = false;
        };
      };
      folders = lib.optionalAttrs remoteReady {
        work_data = {
          id = "${SYNCTHING_FOLDER_ID}";
          label = "Work data";
          path = "${SYNCTHING_FOLDER_PATH}";
          devices = [ "storage" ];

          # Changes and deletions travel in both directions; preserve Unix modes.
          type = "sendreceive";
          ignorePerms = false;

          # Exclude dependencies and caches that can be recreated locally.
          ignorePatterns = [
            "node_modules"
            ".venv"
            "__pycache__"
            ".cache"
            ".direnv"
            ".pytest_cache"
            ".mypy_cache"
            ".ruff_cache"
          ];
        };
      };
    };
  };

  systemd.services.syncthing = lib.mkIf
    (config.services.syncthing.enable && config.services.syncthing.systemService) {
    environment.STNODEFAULTFOLDER = "true";
    serviceConfig.UMask = "0007";
  };
}
