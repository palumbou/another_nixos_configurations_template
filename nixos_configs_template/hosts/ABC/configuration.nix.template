{ config, ... }:
{
  # Import hardware and network configurations
  imports =
    [
      ./hardware-configuration.nix                               # Hardware configuration
      #./external-hardware-configuration.nix                      # External hardware (printer, scanner, etc.)
      #./nm_configurations.nix                                    # Network Manager configurations
      #../../common/config/audio_airplay.nix                      # Audio AirPlay settings
      #../../common/config/audio_chromecast.nix                   # Audio Google Cast settings
      #../../common/config/battery_management.nix                 # Battery management settings
      ../../common/config/boot_luks.nix                          # Boot configuration with Plymouth and LUKS encryption
      ../../common/config/system.nix                             # System settings
      #../../common/gui/gnome.nix                                 # Gnome GUI configuration
      #../../common/gui/hyprland.nix                              # Hyprland GUI configuration
      ../../common/gui/kde.nix                                   # KDE GUI configuration
      ../../common/network/default_network.nix                   # Default network settings
      ../../common/packages/default_packages_services.nix        # Default packages and services
      #../../common/packages/extra_packages_services.nix          # Extra packages and services
      #../../common/packages/external_monitor.nix                 # External monitor (DDC/CI) and webcam support
      #../../common/packages/gamestation_packages.nix             # Gaming packages (Steam, Heroic)
      #../../common/packages/grub.nix                             # GRUB bootloader settings
      #../../common/packages/syncthing.nix                        # Syncthing configuration
      #../../common/packages/unstable_temporary_packages.nix      # Unstable/temporary packages
      #../../common/packages/workstation_packages_services.nix    # Workstation packages and services
      ## Disko module, pinned to a release for reproducibility and supply-chain safety.
      ## To update: pick a tag from https://github.com/nix-community/disko/releases and run
      ##   nix-prefetch-url --unpack https://github.com/nix-community/disko/archive/refs/tags/<tag>.tar.gz
      #"${builtins.fetchTarball {
      #  url = "https://github.com/nix-community/disko/archive/refs/tags/v1.13.0.tar.gz";
      #  sha256 = "03jz60kw0khm1lp72q65z8gq69bfrqqbj08kw0hbiav1qh3g7p08";
      #}}/module.nix"
      #./single-disk-ext4.nix                                     # Disko disk configuration (optional)
      #../secure_boot/secure_boot.nix                             # Secure Boot with Lanzaboote (optional)
      ../../users/XYZ/user.nix                                   # User-specific settings
    ];

  # Bootloader configuration
  #boot.loader.systemd-boot.enable = true;
  #boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.grub.enable = true;
  boot.loader.grub.device = "/dev/disk/by-id/wwn-0x500001234567890a";
  boot.loader.grub.useOSProber = false;

  # Set the hostname
  networking.hostName = "${HOSTNAME}"; # Define your hostname.

  # NixOS release this host was FIRST installed with. Never change it on an
  # existing installation (see the option documentation before touching it).
  # Keeping it per host allows different hosts to have been installed with
  # different releases (e.g. an old host on 25.11, a new one on 26.05).
  system.stateVersion = "${NIXOS_VERSION}";

  # Enable syncing for the specified folders in Syncthing (set the folder name
  # defined in syncthing.nix and uncomment together with the syncthing.nix import)
  #services.syncthing.settings.folders."FOLDER_NAME".enable = true;

  ## Hardware graphics acceleration
  #hardware.graphics = {
  #  enable = true;
  #  enable32Bit = true;  # Required for Wine/Steam/Proton
  #  extraPackages = with pkgs; [
  #    intel-compute-runtime  # OpenCL/Level Zero for Intel GPUs
  #    intel-media-driver        # VA-API moderno (iHD) for Intel GPUs
  #    vpl-gpu-rt                # oneVPL runtime for video acceleration
  #  ];
  #};
}
