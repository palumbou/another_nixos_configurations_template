# Replace these markers with your public age recipients before encryption.
# Add every authorized host recipient to the common rule; keep host rules separate.
keys:
  - &editor REPLACE_WITH_EDITOR_AGE_RECIPIENT
  - &host REPLACE_WITH_HOST_AGE_RECIPIENT

creation_rules:
  - path_regex: ^secrets/common\.yaml$
    key_groups:
      - age:
          - *editor
          - *host
  - path_regex: ^secrets/${HOSTNAME}\.yaml$
    key_groups:
      - age:
          - *editor
          - *host
